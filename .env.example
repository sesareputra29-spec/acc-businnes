# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SHOPEE_PARTNER_ID: Shopee Open Platform Partner ID (Server-side only)
SHOPEE_PARTNER_ID="YOUR_SHOPEE_PARTNER_ID"

# SHOPEE_PARTNER_KEY: Shopee Open Platform Secret Key (Server-side only - Never expose to client)
SHOPEE_PARTNER_KEY="YOUR_SHOPEE_PARTNER_KEY_SECRET"

# SHOPEE_SHOP_ID: Shopee Merchant Shop ID
SHOPEE_SHOP_ID="YOUR_SHOPEE_SHOP_ID"
